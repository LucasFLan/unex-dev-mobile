# Variáveis da stack no Portainer (não commite os valores reais).
# Versão das imagens (tag do Docker Hub). Atualize a cada release.
TAG=1.0.0
FRONT_PORT=23000
BACK_PORT=28080
# "true" quando o acesso for só por https://chamai.grupopapa.com
COOKIE_SECURE=false
CORS_ORIGINS=http://192.168.254.210:23000,http://192.168.254.210:28080,https://chamai.grupopapa.com,http://chamai.grupopapa.com

DB_NAME=servsoft
DB_USERNAME=chamaai
DB_PASSWORD=

# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_VALIDADE=PT1H

# E-mails promovidos a admin ao iniciar (separados por vírgula).
ADMIN_EMAILS=

# Gmail: e-mail e senha de app (16 letras, sem espaços).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
