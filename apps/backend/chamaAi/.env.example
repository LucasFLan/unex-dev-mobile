# Copie este arquivo para ".env" (na mesma pasta) e preencha. O ".env" NÃO vai para o Git.
# O back-end lê o ".env" sozinho ao subir com ./mvnw spring-boot:run.

# --- E-mail (recuperação de senha) ---------------------------------------
# Conta Gmail que envia os e-mails.
MAIL_USERNAME=
# Senha de app de 16 letras gerada em https://myaccount.google.com/apppasswords
# (escreva sem espaços). Não é a senha normal da conta.
MAIL_PASSWORD=
# Só mude se não for Gmail.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# --- Opcional -------------------------------------------------------------
# Com um valor fixo (32+ caracteres), o login continua valendo depois de reiniciar o back.
# JWT_SECRET=
